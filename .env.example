# Copy to .env and adjust as needed. Dummy values only — never commit real secrets.

# Port the Express API listens on
PORT=3001

# Path to the SQLite database file (created automatically if missing)
DATABASE_PATH=./data/app.sqlite

# Set to 1 to skip live Albert Heijn search and always use mock products
AH_FORCE_MOCK=0

# Albert Heijn mobile API (anonymous token — no account or secret)
AH_BASE_URL=https://api.ah.nl
AH_CLIENT_ID=appie

# Signs the session cookie. Use a long random value per environment.
SESSION_SECRET=dev-only-change-me

# Optional pre-seeded account so demo day does not start with a signup form.
# Leave both blank to disable seeding.
DEMO_USERNAME=demo
DEMO_PASSWORD=platewise-demo

# --- Plate AI (OpenRouter preferred) ---
# Put your OpenRouter key here (also accepts the alias AI-KEY).
OPENROUTER_API_KEY=
# Vision-capable model on OpenRouter (examples: openai/gpt-4o-mini, google/gemini-2.0-flash-001)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional aliases the server also reads:
# AI-KEY=
# AI_KEY=
# AI_MODEL=

# Optional direct OpenAI instead of OpenRouter
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
